# --- Runtime (invoiceapp serve / invoiceapp migrate) --------------------------
# PostgreSQL connection string (required).
INVOICEAPP__DATABASE_URL=postgres://invoice:invoice@localhost:5432/invoice
# Connection pool size of `invoiceapp serve` (optional, default 20, at least 1). Connections wait at
# most 5 s for a free slot and run with a 30 s statement / idle-in-transaction timeout.
INVOICEAPP__DB_MAX_CONNECTIONS=20
# Behind a transaction-pooling PgBouncer (true / false, default false): true sends no Postgres
# startup `options`, so the pool runs without the 30 s statement / idle-in-transaction timeouts
# (PgBouncer refuses untracked options and drops tracked ones these settings would need).
INVOICEAPP__DB_PGBOUNCER=false
# Public URL of the instance (required): scheme, base host, optional port. The base host serves
# registration, login and the "my spaces" hub; a space lives at {scheme}://{slug}.{base host}{:port}
# (dev: http://firma.localhost:3000 — *.localhost resolves to 127.0.0.1 in browsers). Production
# needs wildcard DNS + TLS for *.{base host}; the reverse proxy must pass the original Host.
INVOICEAPP__PUBLIC_URL=http://localhost:3000
# Secret key (required): 32 random bytes, base64 — generate with `openssl rand -base64 32`.
# Encrypts TOTP secrets at rest and keys the recovery-code HMAC. Treat it as permanent: losing or
# changing it makes every enrolled TOTP *and* every recovery code unusable. Keep it secret.
INVOICEAPP__SECRET_KEY=REPLACE_WITH_openssl_rand_base64_32
# Public registration on the base host (true / false, default false). true requires SMTP below
# (verification and password reset e-mails); the first user bootstraps the instance this way.
# false also disables creating spaces: only people invited into existing spaces can enter.
INVOICEAPP__REGISTRATION=false
# How many spaces a user may create and own (default 3, at least 1). Spaces they were invited into
# do not count.
INVOICEAPP__MAX_SPACES_PER_USER=
# Take the client IP for the auth rate limits from the last X-Forwarded-For hop (true behind a
# reverse proxy that appends to the header; default false = the socket address). Behind a proxy it
# must be true and the app port must not be reachable directly.
INVOICEAPP__TRUST_FORWARDED=false
# Sign in with Google (optional): set both or neither (only one refuses the start). Register exactly
# one redirect URI in Google Cloud Console: {INVOICEAPP__PUBLIC_URL}/api/auth/google/callback.
INVOICEAPP__GOOGLE__CLIENT_ID=
INVOICEAPP__GOOGLE__CLIENT_SECRET=
# OpenID issuer / discovery base (optional, default https://accounts.google.com; http only for a
# loopback host, e.g. a local mock provider).
INVOICEAPP__GOOGLE__ISSUER=
# Listen address (optional, default 0.0.0.0:3000).
INVOICEAPP__BIND=0.0.0.0:3000
# ARES (Czech business register) REST root (optional, default below).
INVOICEAPP__ARES_URL=https://ares.gov.cz/ekonomicke-subjekty-v-be/rest
# ČNB daily exchange-rate list (optional, default below; `?date=DD.MM.YYYY` is appended).
INVOICEAPP__CNB_URL=https://www.cnb.cz/cs/financni-trhy/devizovy-trh/kurzy-devizoveho-trhu/kurzy-devizoveho-trhu/denni_kurz.txt
# mdcast PDF render service root (optional, default below; empty → default).
INVOICEAPP__MDCAST_URL=https://mdcast.nexial.cz
# Bearer token for mdcast (optional; required by the default service for renders).
INVOICEAPP__MDCAST_TOKEN=
# Concurrent mdcast renders of this instance (optional, default 4, at least 1). A render
# waits up to 10 s for a slot, then 503 pdf_unavailable "busy".
INVOICEAPP__MDCAST_CONCURRENCY=4
# In-memory cache of downloaded PDF design files, all spaces together, in MiB (optional,
# default 128, at least 1); least recently used files are evicted first.
INVOICEAPP__DESIGN_CACHE_MB=128
# File storage for archived PDFs, uploaded originals, e-mail templates and the PDF design
# overrides, every key under spaces/{space id}/ (design: spaces/{id}/design/… — invoice.typ,
# fonts/**/*.ttf|otf, logo.svg|logo.png, signature.png, any other asset; managed with
# `invoiceapp design push|pull|ls|rm --space <slug>`, which also needs INVOICEAPP__DATABASE_URL).
# Backend: fs (default) or s3.
INVOICEAPP__STORAGE_KIND=fs
# fs: root directory (optional, default ./data; created at start).
INVOICEAPP__STORAGE_DIR=./data
# s3: any S3-compatible service (AWS, Garage, MinIO, R2). Endpoint empty → AWS;
# bucket, access key and secret required; region default us-east-1.
# PATH_STYLE=true (Garage / MinIO): requests go to {endpoint}/{bucket}/{key}.
# PATH_STYLE=false (virtual-hosted): the bucket is put into the host,
# https://s3.example.com → https://{bucket}.s3.example.com (kept as is when the
# endpoint host already starts with "{bucket}.").
INVOICEAPP__S3__ENDPOINT=
INVOICEAPP__S3__BUCKET=
INVOICEAPP__S3__REGION=
INVOICEAPP__S3__ACCESS_KEY_ID=
INVOICEAPP__S3__SECRET_ACCESS_KEY=
INVOICEAPP__S3__PATH_STYLE=
# E-mail (SMTP) for sending issued documents and the account e-mails (verification, password
# reset); HOST empty → e-mail not configured (then registration must stay off).
# TLS: starttls (default, port 587) | tls (implicit, 465) | none (plain, 25 — tests /
# local relay only). USERNAME and PASSWORD both or neither; with TLS=none only when HOST is
# loopback (localhost, 127.0.0.0/8, ::1). FROM (required with HOST):
# addr@x or "Name <addr@x>". Invalid values refuse the start.
INVOICEAPP__SMTP__HOST=
INVOICEAPP__SMTP__PORT=
INVOICEAPP__SMTP__TLS=
INVOICEAPP__SMTP__USERNAME=
INVOICEAPP__SMTP__PASSWORD=
INVOICEAPP__SMTP__FROM=
# Kill switch (true / false, default false): refuse every e-mail sent on behalf of a space (503
# email_disabled) and skip account e-mails (verify, reset, invitations; logged). Per-space and
# per-user-in-space e-mail limits (default 100 / day, 20 / hour) live in the space_limits table.
INVOICEAPP__EMAIL_DISABLED=
# Log filter (optional, default invoiceapp=info,tower_http=info,sea_orm_migration=info).
RUST_LOG=invoiceapp=info,tower_http=info,sea_orm_migration=info

# --- Tests -------------------------------------------------------------------
# Postgres used by the integration tests (each test gets a throwaway schema).
# Required by `cargo test --test '*'`; the Makefile defaults to the value below.
# One-time local setup (as a Postgres superuser):
#   create role invoice login password 'invoice';
#   create database invoice owner invoice;
#   create database invoice_test owner invoice;
TEST_DATABASE_URL=postgres://invoice:invoice@localhost:5432/invoice_test
# S3 test bucket for the storage suite (path-style; every test works under a random
# prefix and deletes it). Required by `cargo test --test '*'` — the S3 tests fail,
# not skip, without it. The Makefile reads these from .env.
TEST_S3_ENDPOINT=
TEST_S3_BUCKET=
TEST_S3_REGION=
TEST_S3_ACCESS_KEY_ID=
TEST_S3_SECRET_ACCESS_KEY=
# Optional: INVOICEAPP__SECRET_KEY of the test apps (32 bytes, base64); unset → a fixed test key.
#TEST_SECRET_KEY=
